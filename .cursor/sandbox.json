{
  "type": "workspace_readwrite",
  "enableSharedBuildCache": true,
  "networkPolicy": {
    "default": "deny",
    "allow": [
      "github.com",
      "api.github.com",
      "codeload.github.com",
      "*.githubusercontent.com",
      "crates.io",
      "index.crates.io",
      "static.crates.io",
      "rustup.rs",
      "static.rust-lang.org",
      "pypi.org",
      "files.pythonhosted.org",
      "*.trunk.io"
    ]
  }
}
